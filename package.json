{
  "name": "prompt-hash-stellar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Soroban-based prompt licensing marketplace with XLM payments and wallet-verified unlocks.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Obiajulu-gif/Prompt-Hash-Stellar"
  },
  "scripts": {
    "dev": "node scripts/check-local-setup.mjs --warn-only && vite",
    "start": "vite",
    "build": "vite build",
    "prebuild": "node scripts/check-local-setup.mjs --warn-only",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:contract": "cargo test -p prompt-hash",
    "test:gas": "cargo test -p prompt-hash --locked --features isolate-gas-bench gas_benchmarks -- --nocapture",
    "test:gas:harness": "node scripts/check-gas-regression.mjs --self-test",
    "test:all": "vitest run && cargo test -p prompt-hash && cd server && npm test",
    "security:dast-target": "node scripts/security/dast-target.mjs",
    "security:contract-analysis": "bash scripts/security/contract-analysis.sh",
    "benchmark:unlock": "node scripts/benchmark-unlock.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "check:setup": "node scripts/check-local-setup.mjs",
    "deploy:manifest": "node scripts/deploy-manifest.mjs",
    "chain:status": "node scripts/chain-status.mjs",
    "catalog:export": "node scripts/creator-catalog-export.mjs",
    "upgrade:dry-run": "node scripts/upgrade-dry-run.mjs",
    "check:runbook": "node scripts/runbook-check.mjs",
    "test:synthetic": "npx tsx scripts/synthetic-unlock.ts",
    "load:fixtures": "node scripts/load/generate-unlock-fixtures.mjs",
    "load:test": "k6 run load-tests/prompt-mint.js",
    "load:compare": "node scripts/load/compare-results.mjs",
    "ops:rollback": "npx tsx scripts/ci-rollback.ts",
    "inspect:contract": "npx tsx scripts/inspect-contract.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@jadonamite/automata-sdk": "^1.0.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@stellar/design-system": "^4.0.2",
    "@stellar/stellar-base": "^14.0.2",
    "@stellar/stellar-sdk": "^14.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.33.0",
    "mongoose": "9.9.3",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "redis": "^4.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "node-mock-http": "^1.0.5",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  },
  "keywords": [
    "stellar",
    "soroban",
    "xlm",
    "creator-economy",
    "ai-prompts",
    "marketplace"
  ],
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c",
  "resolutions": {
    "@stellar/stellar-sdk": "14.6.1"
  }
}
